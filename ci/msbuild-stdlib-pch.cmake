if(NOT CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  return()
endif()
include_guard(GLOBAL)

if(NOT DEFINED OPENCV_MSBUILD_PCH_HEADER_SET)
  set(OPENCV_MSBUILD_PCH_HEADER_SET "six" CACHE STRING "Owned stdlib PCH header set")
endif()
set_property(CACHE OPENCV_MSBUILD_PCH_HEADER_SET PROPERTY STRINGS six ten)
if(NOT OPENCV_MSBUILD_PCH_HEADER_SET STREQUAL "six" AND
   NOT OPENCV_MSBUILD_PCH_HEADER_SET STREQUAL "ten")
  message(FATAL_ERROR "The combined PCH header set must be six or ten")
endif()

function(opencv_msbuild_stdlib_pch)
  if(NOT MSVC OR NOT CMAKE_GENERATOR STREQUAL "Visual Studio 18 2026")
    message(FATAL_ERROR "The combined PCH experiment requires native MSVC/Visual Studio")
  endif()
  get_target_property(kind opencv_world TYPE)
  if(NOT kind STREQUAL "SHARED_LIBRARY")
    message(FATAL_ERROR "The combined PCH experiment requires shared opencv_world")
  endif()
  if(ENABLE_PRECOMPILED_HEADERS)
    message(FATAL_ERROR "Legacy world PCH must remain disabled")
  endif()
  set(headers vector algorithm string memory utility limits)
  if(OPENCV_MSBUILD_PCH_HEADER_SET STREQUAL "ten")
    list(APPEND headers mutex ostream cmath functional)
  endif()
  foreach(header IN LISTS headers)
    target_precompile_headers(opencv_world PRIVATE
      "$<$<COMPILE_LANGUAGE:CXX>:<${header}$<ANGLE-R>>")
  endforeach()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL opencv_msbuild_stdlib_pch)
